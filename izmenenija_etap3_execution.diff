+def has_unresolved_sell(pos) -> bool:
+    """
+    SAFETY FIX ЭТАП 3: есть ли у позиции незавершённая/неопределённая
+    SELL-заявка (fail-closed).
+
+    True, если:
+      - активный курсор close_order_id установлен — связь с SELL, которая
+        не была достоверно разрешена (полный FILL переводит позицию в CLOSED
+        мимо этой проверки; терминальные отказы и частичное терминальное
+        исполнение снимают курсор штатными путями resolve_closing /
+        apply_close_execution; NOT_FOUND/None курсор НЕ снимают);
+      - или в журнале close_orders есть запись с нетерминальным статусом
+        (INTENT/SENT/NEW/PARTIALLYFILL/UNCERTAIN/неизвестный).
+    Записи с терминальным статусом (FILL/CANCELLED/REJECTED/EXPIRED) без
+    активного курсора незавершённую SELL не образуют.
+    """
+    if pos is None:
+        return False
+    if pos.close_order_id:
+        return True
+    for rec in (pos.close_orders or {}).values():
+        if str(rec.get("status") or "").upper() not in SELL_TERMINAL_STATUSES:
+            return True
+    return False
+
